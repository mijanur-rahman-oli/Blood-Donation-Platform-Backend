# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blood_donation_db?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Google OAuth (GCP Social Login)
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# SSLCommerz (Payment Gateway)
SSLCOMMERZ_STORE_ID=replace_with_store_id
SSLCOMMERZ_STORE_PASSWORD=replace_with_store_password
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=http://localhost:5000/api/v1/payments/success
SSLCOMMERZ_FAIL_URL=http://localhost:5000/api/v1/payments/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:5000/api/v1/payments/cancel
SSLCOMMERZ_IPN_URL=http://localhost:5000/api/v1/payments/ipn

# Admin seed credentials (used by prisma/seed.ts)
ADMIN_EMAIL=admin@blooddonation.com
ADMIN_PASSWORD=Admin@12345
